{
  "name": "cafeproject",
  "private": true,
  "description": "JL Cafe Project - Cafe tracker, map, rankings, drink logs and stats",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.js",
    "format": "prettier --write \"js/*.js\" server.js eslint.config.js scripts/*.js",
    "test": "node tests/run.js",
    "test:unit": "node tests/unit.js",
    "test:site": "node tests/site.js",
    "build": "node scripts/build-site.js",
    "test:live": "node tests/csp-live.js",
    "test:rules": "npx -y firebase-tools@15.33.0 emulators:exec --only database --project demo-cafemap \"node tests/rules.js --emulator\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "snapshot": "node tests/snapshot.js",
    "bump": "node scripts/bump.js",
    "sri": "node scripts/sri.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
