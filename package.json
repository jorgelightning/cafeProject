{
  "name": "cafeproject",
  "private": true,
  "description": "JL Cafe Project - Cafe tracker, map, rankings, drink logs and stats",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.js",
    "format": "prettier --write \"js/*.js\" server.js eslint.config.js scripts/*.js",
    "test": "node tests/run.js",
    "check": "npm run lint && npm run typecheck && npm test",
    "snapshot": "node tests/snapshot.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
